    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.19",
